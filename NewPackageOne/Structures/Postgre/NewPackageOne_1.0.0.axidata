            "dc2": {
              "row1": {
                "html_editor_htmlsrc": "<html lang=\"en\"><head></head><body>\r\n\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>Package Export</title>\r\n\r\n  <style>\r\n    * {\r\n      box-sizing: border-box;\r\n    }\r\n\r\n    body {\r\n      margin: 0;\r\n      background: #f4f7fb;\r\n      font-family: urbanist !important;\r\n      color: #101828;\r\n      font-weight: 600;\r\n      background: #f5f6fb !important;\r\n    }\r\n\r\n    .pkg-page {\r\n      padding: 15px 24px;\r\n      min-height: 100vh;\r\n      padding-bottom: 0 !important;\r\n    }\r\n\r\n    .pkg-header {\r\n      display: flex;\r\n      justify-content: space-between;\r\n      align-items: center;\r\n      gap: 20px;\r\n      margin-bottom: 24px;\r\n    }\r\n\r\n    .pkg-header h1 {\r\n      margin: 0;\r\n      font-size: 20px;\r\n      font-weight: 700;\r\n      color: #303a69;\r\n    }\r\n\r\n    .pkg-header p {\r\n      margin: 6px 0 0;\r\n      color: #667085;\r\n      font-size: 14px;\r\n    }\r\n\r\n    .header-actions {\r\n      display: none;\r\n    }\r\n\r\n    .btn {\r\n      border: 0;\r\n      border-radius: 10px;\r\n      padding: 10px 18px;\r\n      font-weight: 700;\r\n      cursor: pointer;\r\n      font-size: 13px;\r\n      font-family: urbanist !important;\r\n    }\r\n\r\n    .btn.primary {\r\n      background: #0d6efd;\r\n      color: #fff;\r\n    }\r\n\r\n    .btn.secondary {\r\n      background: #fff;\r\n      color: #344054;\r\n      border: 1px solid #d0d5dd;\r\n    }\r\n\r\n    .summary-grid {\r\n      display: grid;\r\n      grid-template-columns: repeat(4, 1fr);\r\n      gap: 7px;\r\n      margin-bottom: 12px;\r\n    }\r\n\r\n    .summary-card {\r\n      background: #fff;\r\n      border: 1px solid #e4e7ec;\r\n      border-radius: 6px;\r\n      padding: 7px 14px;\r\n      display: flex;\r\n      gap: 16px;\r\n      align-items: center;\r\n      cursor: pointer;\r\n      transition: 0.2s ease;\r\n      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.04);\r\n    }\r\n\r\n    .summary-card:hover,\r\n    .summary-card.active {\r\n      box-shadow: 0 10px 30px rgba(13, 110, 253, 0.15);\r\n      transform: translateY(-2px);\r\n      border: 1px solid #303a6966 !important;\r\n    }\r\n\r\n    .card-icon {\r\n      width: 32px;\r\n      height: 32px;\r\n      border-radius: 50px;\r\n      display: grid;\r\n      place-items: center;\r\n      font-weight: 800;\r\n      font-size: 14px;\r\n    }\r\n\r\n    .blue {\r\n      background: #f4bc01;\r\n      color: white !important;\r\n    }\r\n\r\n    .purple {\r\n      background: #3d5996;\r\n      color: #fff !important;\r\n    }\r\n\r\n    .green {\r\n      background: #e80502;\r\n      color: #fff !important;\r\n    }\r\n\r\n    .orange {\r\n      background: #73a29a;\r\n      color: #fff;\r\n    }\r\n\r\n    .summary-card label {\r\n      color: #667085;\r\n      font-size: 13px;\r\n      font-weight: 600;\r\n    }\r\n\r\n    .summary-card h2 {\r\n      margin: 3px 0 0 0;\r\n      font-size: 19px;\r\n    }\r\n\r\n    .pkg-layout {\r\n      display: grid;\r\n      grid-template-columns: 240px 1fr 320px;\r\n      gap: 10px;\r\n    }\r\n\r\n    .pkg-sidebar,\r\n    .pkg-content,\r\n    .publish-panel {\r\n      background: #fff;\r\n      border: 1px solid #e4e7ec;\r\n      border-radius: 0;\r\n      padding: 18px;\r\n      height: calc(100vh - 220px);\r\n      overflow: scroll;\r\n      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.04);\r\n    }\r\n\r\n    .pkg-sidebar h3,\r\n    .publish-panel h3 {\r\n      margin: 0 0 16px;\r\n      font-size: 16px;\r\n      background: #f5f6fb;\r\n      padding: 9px 15px;\r\n      margin-inline: -16px;\r\n      margin-top: -15px;\r\n      position: sticky;\r\n      top: -19px;\r\n    }\r\n\r\n    .side-link {\r\n      width: 100%;\r\n      border: 0;\r\n      background: transparent;\r\n      display: flex;\r\n      justify-content: space-between;\r\n      padding: 12px;\r\n      border-radius: 10px;\r\n      font-weight: 600;\r\n      margin-bottom: 6px;\r\n      cursor: pointer;\r\n      color: #344054;\r\n      font-family: urbanist !important;\r\n    }\r\n\r\n    .side-link.active,\r\n    .side-link:hover {\r\n      background: #303a69;\r\n      color: white;\r\n    }\r\n\r\n    .content-toolbar {\r\n      display: flex;\r\n      gap: 12px;\r\n      margin-bottom: 18px;\r\n    }\r\n\r\n    .search-box {\r\n      flex: 1;\r\n      display: flex;\r\n      align-items: center;\r\n      background: #f9fafb;\r\n      border: 1px solid #d0d5dd;\r\n      border-radius: 0;\r\n      padding: 0 12px;\r\n    }\r\n\r\n    .search-box input {\r\n      border: 0;\r\n      background: transparent;\r\n      width: 100%;\r\n      outline: none;\r\n      padding: 10px;\r\n      font-size: 14px;\r\n    }\r\n\r\n    select,\r\n    input,\r\n    textarea {\r\n      border: 1px solid #d0d5dd;\r\n      border-radius: 0;\r\n      padding: 11px 11px;\r\n      outline: none;\r\n      font-size: 13px;\r\n      font-family: urbanist;\r\n      font-weight: 600;\r\n    }\r\n\r\n    .table-card {\r\n      border: 1px solid #eaecf0;\r\n      border-radius: 14px;\r\n      overflow: hidden;\r\n    }\r\n\r\n    .table-head,\r\n    .table-row {\r\n      display: grid;\r\n      grid-template-columns: 2fr 1fr 1.5fr;\r\n      gap: 12px;\r\n      align-items: center;\r\n      padding: 14px 16px;\r\n    }\r\n\r\n    .table-head {\r\n      background: #f9fafb;\r\n      color: #667085;\r\n      font-size: 13px;\r\n      font-weight: 800;\r\n      padding: 7px 16px;\r\n    }\r\n\r\n    .table-row {\r\n      border-top: 1px solid #eaecf0;\r\n    }\r\n\r\n    .table-row:hover,\r\n    .table-row.selected {\r\n      background: #f5f9ff;\r\n    }\r\n\r\n    .table-row label {\r\n      display: flex;\r\n      gap: 12px;\r\n      align-items: center;\r\n    }\r\n\r\n    .table-row strong {\r\n      font-size: 14px;\r\n    }\r\n\r\n    .table-row small {\r\n      display: block;\r\n      color: #667085;\r\n      margin-top: 3px;\r\n    }\r\n\r\n    .pill {\r\n      width: max-content;\r\n      padding: 5px 10px;\r\n      border-radius: 10px;\r\n      font-size: 12px;\r\n      font-weight: 600;\r\n    }\r\n\r\n    .pill.tstruct {\r\n      background: #eaf2ff;\r\n      color: #0d6efd;\r\n    }\r\n\r\n    .pill.iview {\r\n      background: #f4ebff;\r\n      color: #7f56d9;\r\n    }\r\n\r\n    .pill.page {\r\n      background: #ecfdf3;\r\n      color: #039855;\r\n    }\r\n\r\n    .pill.datasource {\r\n      background: #fff4e5;\r\n      color: #f79009;\r\n    }\r\n\r\n    .pill.role {\r\n      background: #f2f4f7;\r\n      color: #344054;\r\n    }\r\n\r\n    .pill.db {\r\n      background: #fef3f2;\r\n      color: #d92d20;\r\n    }\r\n\r\n    .object-meta {\r\n      color: #4a4e57;\r\n      font-size: 13px;\r\n    }\r\n\r\n    .publish-panel {\r\n      display: flex;\r\n      flex-direction: column;\r\n      gap: 12px;\r\n    }\r\n\r\n    .summary-line {\r\n      display: flex;\r\n      justify-content: space-between;\r\n      color: #475467;\r\n      font-size: 14px;\r\n    }\r\n\r\n    .publish-panel label {\r\n      font-size: 13px;\r\n      font-weight: 700;\r\n      color: #344054;\r\n    }\r\n\r\n    .publish-panel textarea {\r\n      min-height: 90px;\r\n      resize: vertical;\r\n    }\r\n\r\n    .helper-card {\r\n      background: #f9fafb;\r\n      border: 1px dashed #d0d5dd;\r\n      border-radius: 14px;\r\n      padding: 14px;\r\n      color: #475467;\r\n      font-size: 13px;\r\n      line-height: 1.6;\r\n    }\r\n\r\n    .helper-card strong {\r\n      display: block;\r\n      color: #101828;\r\n      margin-bottom: 6px;\r\n      font-size: 14px;\r\n    }\r\n\r\n    .full {\r\n      width: 100%;\r\n      margin-top: 8px;\r\n    }\r\n\r\n    .sticky-bar {\r\n      position: sticky;\r\n      bottom: 0px;\r\n      margin-top: 16px;\r\n      background: #303a69;\r\n      color: #fff;\r\n      border-radius: 0;\r\n      padding: 5px 17px;\r\n      display: flex;\r\n      align-items: center;\r\n      gap: 14px;\r\n      box-shadow: 0 16px 40px rgba(16, 24, 40, 0.25);\r\n      margin-inline: -24px;\r\n    }\r\n\r\n    .sticky-bar strong {\r\n      margin-right: 10px;\r\n    }\r\n\r\n    .sticky-bar span {\r\n      color: #d0d5dd;\r\n      margin-right: auto;\r\n    }\r\n\r\n    .modal-overlay {\r\n      position: fixed;\r\n      inset: 0;\r\n      background: rgba(16, 24, 40, 0.58);\r\n      display: none;\r\n      align-items: center;\r\n      justify-content: center;\r\n      z-index: 9999;\r\n      padding: 24px;\r\n    }\r\n\r\n    .modal {\r\n      width: min(980px, 100%);\r\n      max-height: 90vh;\r\n      overflow: hidden;\r\n      background: #fff;\r\n      border-radius: 20px;\r\n      box-shadow: 0 30px 80px rgba(16, 24, 40, 0.35);\r\n    }\r\n\r\n    .modal-header {\r\n      padding: 14px 24px;\r\n      border-bottom: 1px solid #eaecf0;\r\n      display: flex;\r\n      justify-content: space-between;\r\n      align-items: center;\r\n      background: #f5f6fb;\r\n    }\r\n\r\n    .modal-header h2 {\r\n      margin: 0;\r\n      font-size: 20px;\r\n    }\r\n\r\n    .modal-body {\r\n      padding: 24px;\r\n      display: grid;\r\n      grid-template-columns: 1fr 300px;\r\n      gap: 20px;\r\n      height: calc(100vh - 200px);\r\n      overflow: hidden;\r\n    }\r\n\r\n    .modal-list {\r\n      border: 1px solid #eaecf0;\r\n      border-radius: 14px;\r\n      overflow: hidden;\r\n      height: calc(100vh - 33%);\r\n      overflow: scroll;\r\n    }\r\n\r\n    .modal-row {\r\n      display: grid;\r\n      grid-template-columns: 1fr auto;\r\n      gap: 12px;\r\n      padding: 14px 16px;\r\n      border-bottom: 1px solid #eaecf0;\r\n      align-items: center;\r\n    }\r\n\r\n    .modal-row:last-child {\r\n      border-bottom: 0;\r\n    }\r\n\r\n    .modal-row small {\r\n      color: #667085;\r\n      display: block;\r\n      margin-top: 4px;\r\n    }\r\n\r\n    .modal-side {\r\n      background: #f9fafb;\r\n      border: 1px solid #eaecf0;\r\n      border-radius: 14px;\r\n      padding: 16px;\r\n      display: flex;\r\n      flex-direction: column;\r\n      gap: 12px;\r\n      height: calc(100vh - 28%);\r\n      overflow: scroll;\r\n    }\r\n\r\n    .modal-footer {\r\n      padding: 8px 24px;\r\n      border-top: 1px solid #eaecf0;\r\n      display: flex;\r\n      justify-content: flex-end;\r\n      gap: 12px;\r\n    }\r\n\r\n    @media (max-width: 1200px) {\r\n      .pkg-layout {\r\n        grid-template-columns: 220px 1fr;\r\n      }\r\n\r\n      .publish-panel {\r\n        grid-column: 1 / -1;\r\n      }\r\n    }\r\n\r\n    @media (max-width: 768px) {\r\n      .pkg-header,\r\n      .content-toolbar,\r\n      .sticky-bar {\r\n        flex-direction: column;\r\n        align-items: stretch;\r\n      }\r\n\r\n      .summary-grid {\r\n        grid-template-columns: 1fr 1fr;\r\n      }\r\n\r\n      .pkg-layout,\r\n      .modal-body {\r\n        grid-template-columns: 1fr;\r\n      }\r\n\r\n      .table-head {\r\n        display: none;\r\n      }\r\n\r\n      .table-row {\r\n        grid-template-columns: 1fr;\r\n      }\r\n    }\r\n\r\n    .summary-card div:nth-child(2) {\r\n      align-items: center;\r\n    }\r\n\r\n    #summaryCards .summary-card:nth-child(4n+1) h2 {\r\n      color: #755c09;\r\n    }\r\n\r\n    #summaryCards .summary-card:nth-child(4n+2) h2 {\r\n      color: #3d5996;\r\n    }\r\n\r\n    #summaryCards .summary-card:nth-child(4n+3) h2 {\r\n      color: #c60b09;\r\n    }\r\n\r\n    #summaryCards .summary-card:nth-child(4n+4) h2 {\r\n      color: #4d746d;\r\n    }\r\n\r\n    .pkg-content {\r\n      overflow: hidden;\r\n    }\r\n\r\n    .pkg-content .table-card {\r\n      overflow-y: scroll;\r\n      height: calc(100% - 55px);\r\n      overflow-x: hidden;\r\n    }\r\n\r\n    .pkg-content .table-head {\r\n      position: sticky;\r\n      top: 0;\r\n    }\r\n\r\n    .modal-header p {\r\n      font-size: 14px;\r\n      margin-top: 4px !important;\r\n    }\r\n\r\n    strong {\r\n      font-weight: 700;\r\n    }\r\n\r\n    .modal-body h3 {\r\n      font-size: 17px;\r\n      font-weight: 700;\r\n    }\r\n\r\n    .modal-row strong {\r\n      font-size: 15px;\r\n    }\r\n  </style>\r\n\r\n\r\n\r\n  <div class=\"pkg-page\">\r\n\r\n    <div class=\"pkg-header\">\r\n      <div>\r\n        <h1>Package Export</h1>\r\n        <p>Select Axi Objects and publish the package to Git</p>\r\n      </div>\r\n\r\n      <div class=\"header-actions\">\r\n        <button class=\"btn secondary\">Save Draft</button>\r\n        <button class=\"btn primary\">Publish to Git</button>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"summary-grid\" id=\"summaryCards\"></div>\r\n\r\n    <div class=\"pkg-layout\">\r\n\r\n      <aside class=\"pkg-sidebar\">\r\n        <h3>Object Types</h3>\r\n        <div id=\"sideMenu\"></div>\r\n      </aside>\r\n\r\n      <main class=\"pkg-content\">\r\n        <div class=\"content-toolbar\">\r\n          <div class=\"search-box\">\r\n            <span>🔍</span>\r\n            <input id=\"searchInput\" placeholder=\"Search by object name, code, type...\">\r\n          </div>\r\n\r\n          <select id=\"sortBy\">\r\n            <option value=\"name\">Sort by Name</option>\r\n            <option value=\"type\">Sort by Type</option>\r\n          </select>\r\n        </div>\r\n\r\n        <div class=\"table-card\">\r\n          <div class=\"table-head\">\r\n            <label>\r\n              <input type=\"checkbox\" id=\"selectAll\">\r\n              Object\r\n            </label>\r\n            <span>Object Type</span>\r\n            <span>Export Information</span>\r\n          </div>\r\n\r\n          <div id=\"objectRows\"></div>\r\n        </div>\r\n      </main>\r\n\r\n      <aside class=\"publish-panel\">\r\n        <h3>Package Summary</h3>\r\n\r\n        <div class=\"summary-line\">\r\n          <span>Total Objects</span>\r\n          <b>370</b>\r\n        </div>\r\n\r\n        <div class=\"summary-line\">\r\n          <span>Selected Objects</span>\r\n          <b id=\"selectedCount\">0</b>\r\n        </div>\r\n\r\n        <div class=\"summary-line\">\r\n          <span>Selected Types</span>\r\n          <b id=\"selectedTypes\">0</b>\r\n        </div>\r\n\r\n        <hr>\r\n\r\n        <label>Package Name</label>\r\n        <input id=\"packageName\" placeholder=\"Ex: ERP\">\r\n\r\n        <label>Git Branch</label>\r\n        <select id=\"gitBranch\">\r\n          <option>main</option>\r\n          <option>dev</option>\r\n          <option>release/v1</option>\r\n        </select>\r\n\r\n        <label>Package Description</label>\r\n        <textarea id=\"packageDescription\" placeholder=\"Ex: ERP package for managing enterprise resource planning modules and related AXI components.\"></textarea>\r\n\r\n        <div class=\"helper-card\">\r\n          <strong>Export Notes</strong>\r\n          Selected objects will be grouped by object type and prepared as one package before publishing to Git.\r\n        </div>\r\n\r\n        <button class=\"btn primary full\" onclick=\"publishPackage()\">Publish Package</button>\r\n      </aside>\r\n    </div>\r\n\r\n    <div class=\"sticky-bar\">\r\n      <strong id=\"footerSelected\">0 objects selected</strong>\r\n      <span id=\"footerStatus\">Select objects to create package</span>\r\n      <button class=\"btn primary\" onclick=\"openPreviewModal()\">Preview and Publish</button>\r\n    </div>\r\n\r\n  </div>\r\n\r\n  <div class=\"modal-overlay\" id=\"previewModal\">\r\n    <div class=\"modal\">\r\n      <div class=\"modal-header\">\r\n        <div>\r\n          <h2>Preview Package</h2>\r\n          <p style=\"margin:6px 0 0;color:#667085;\">Review selected objects before publishing to Git.</p>\r\n        </div>\r\n        <button class=\"btn secondary\" onclick=\"closePreviewModal()\">Close</button>\r\n      </div>\r\n\r\n      <div class=\"modal-body\">\r\n        <div>\r\n          <h3 style=\"margin-top:0;\">Selected Objects</h3>\r\n          <div class=\"modal-list\" id=\"modalObjectList\"></div>\r\n        </div>\r\n\r\n        <div class=\"modal-side\">\r\n          <h3 style=\"margin:0;\">Publish Details</h3>\r\n\r\n          <label>Package Name</label>\r\n          <input id=\"modalPackageName\" placeholder=\"Ex: ERP\">\r\n\r\n          <label>Git Branch</label>\r\n          <select id=\"modalGitBranch\">\r\n            <option>main</option>\r\n            <option>dev</option>\r\n            <option>release/v1</option>\r\n          </select>\r\n\r\n          <label>Package Description</label>\r\n          <textarea id=\"modalPackageDescription\" placeholder=\"Ex: ERP package for managing enterprise resource planning modules and related AXI components.\"></textarea>\r\n\r\n          <div class=\"summary-line\">\r\n            <span>Objects</span>\r\n            <b id=\"modalSelectedCount\">0</b>\r\n          </div>\r\n\r\n          <div class=\"summary-line\">\r\n            <span>Types</span>\r\n            <b id=\"modalTypeCount\">0</b>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"modal-footer\">\r\n        <button class=\"btn secondary\" onclick=\"closePreviewModal()\">Cancel</button>\r\n        <button class=\"btn primary\" onclick=\"publishPackage()\">Publish Package</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <script>\r\n    let objects = [];\r\n    let typeCountsFromServer = {};\r\n    let metaList = [];\r\n\r\n    const typeColors = {\r\n      \"TStructs\": \"blue\",\r\n      \"iViews\": \"purple\",\r\n      \"Pages\": \"green\",\r\n      \"Data Sources\": \"orange\",\r\n      \"Cards\": \"purple\",\r\n      \"Developer Options\": \"blue\",\r\n      \"AXVars\": \"purple\",\r\n      \"User Roles\": \"green\",\r\n      \"User Groups\": \"green\",\r\n      \"Tables\": \"green\",\r\n      \"Views\": \"purple\",\r\n      \"Materialized Views\": \"purple\",\r\n      \"Functions\": \"orange\",\r\n      \"Procedures\": \"orange\",\r\n      \"Triggers\": \"green\",\r\n      \"Index\": \"blue\",\r\n      \"Sequences\": \"purple\",\r\n      \"Constraints\": \"orange\",\r\n      \"Others\": \"orange\"\r\n    };\r\n\r\n    const typeClass = {\r\n      \"TStructs\": \"tstruct\",\r\n      \"iViews\": \"iview\",\r\n      \"Pages\": \"page\",\r\n      \"Data Sources\": \"datasource\",\r\n      \"Cards\": \"page\",\r\n      \"Developer Options\": \"tstruct\",\r\n      \"AXVars\": \"iview\",\r\n      \"User Roles\": \"role\",\r\n      \"User Groups\": \"role\",\r\n      \"Tables\": \"db\",\r\n      \"Views\": \"db\",\r\n      \"Materialized Views\": \"db\",\r\n      \"Functions\": \"db\",\r\n      \"Procedures\": \"db\",\r\n      \"Triggers\": \"db\",\r\n      \"Index\": \"db\",\r\n      \"Sequences\": \"db\",\r\n      \"Constraints\": \"db\",\r\n      \"Others\": \"role\"\r\n    };\r\n\r\n    const selectedObjects = new Set();\r\n    let activeType = \"\";\r\n\r\n    document.getElementById(\"searchInput\").addEventListener(\"input\", renderRows);\r\n    document.getElementById(\"sortBy\").addEventListener(\"change\", renderRows);\r\n\r\n    document.getElementById(\"selectAll\").addEventListener(\"change\", function () {\r\n      getFilteredObjects().forEach(obj => {\r\n        this.checked ? selectedObjects.add(obj.id) : selectedObjects.delete(obj.id);\r\n      });\r\n\r\n      renderRows();\r\n      updateSummary();\r\n    });\r\n\r\n    function init() {\r\n      getMetaData();\r\n    }\r\n\r\n    function getMetaData() {\r\n      const sqlParams = {\r\n        param1: \"admin\",\r\n        param2: \"default\",\r\n        param3: \"default\",\r\n        param4: \"app\",\r\n        param5: \"all\"\r\n      };\r\n\r\n      const params = {\r\n        adsNames: [\r\n          \"axi_packagemetalist\"\r\n        ],\r\n        refreshCache: false,\r\n        sqlParams,\r\n        props: {\r\n          pageno: 1,\r\n          pagesize: 5000\r\n        }\r\n      };\r\n\r\n      parent.GetDataFromAxList(\r\n        params,\r\n        (response) => {\r\n          try {\r\n            const parsed = JSON.parse(response);\r\n            const rows = parsed?.result?.data?.[0]?.data || [];\r\n\r\n            metaList = rows;\r\n\r\n            objects = rows.map((item, index) => {\r\n              return {\r\n                id: `${item.stype}_${index}`,\r\n                name: item.caption || item.name,\r\n                code: item.name,\r\n                type: mapObjectType(item.stype),\r\n                raw: item\r\n              };\r\n            });\r\n\r\n            generateTypeCounts();\r\n\r\n            renderSummaryCards();\r\n            renderSideMenu();\r\n            renderRows();\r\n            updateSummary();\r\n\r\n          } catch (e) {\r\n            console.error(\"Metadata Parse Error:\", e);\r\n          }\r\n        },\r\n        (err) => {\r\n          console.error(\"Datasource Error:\", err);\r\n        }\r\n      );\r\n    }\r\n\r\n   function mapObjectType(stype) {\r\n  const typeMap = {\r\n    t: \"TStructs\",\r\n    ts: \"TStructs\",\r\n\r\n    i: \"iViews\",\r\n    iv: \"iViews\",\r\n\r\n    p: \"Pages\",\r\n    pg: \"Pages\",\r\n\r\n    ads: \"Data Sources\",\r\n    ds: \"Data Sources\",\r\n\r\n    card: \"Cards\",\r\n    c: \"Cards\",\r\n\r\n    developeroption: \"Developer Options\",\r\n    devopt: \"Developer Options\",\r\n\r\n    axvars: \"AXVars\",\r\n    axv: \"AXVars\",\r\n\r\n    r: \"User Roles\",\r\n    role: \"User Roles\",\r\n    userrole: \"User Roles\",\r\n\r\n    usergroup: \"User Groups\",\r\n    ug: \"User Groups\",\r\n\r\n    tbl: \"Tables\",\r\n    table: \"Tables\",\r\n\r\n    vw: \"Views\",\r\n    view: \"Views\",\r\n    views: \"Views\",\r\n\r\n    mvw: \"Materialized Views\",\r\n    matview: \"Materialized Views\",\r\n    mview: \"Materialized Views\",\r\n\r\n    // FIXED: Mapped 'function', 'fn', and 'func' directly to \"Functions\"\r\n    fn: \"Functions\",\r\n    func: \"Functions\",\r\n    function: \"Functions\",\r\n    functions: \"Functions\",\r\n\r\n    sp: \"Procedures\",\r\n    proc: \"Procedures\",\r\n    procedure: \"Procedures\",\r\n    procedures: \"Procedures\",\r\n\r\n    trg: \"Triggers\",\r\n    trigger: \"Triggers\",\r\n    triggers: \"Triggers\",\r\n\r\n    idx: \"Index\",\r\n    index: \"Index\",\r\n\r\n    seq: \"Sequences\",\r\n    sequence: \"Sequences\",\r\n    sequences: \"Sequences\",\r\n\r\n    cons: \"Constraints\",\r\n    constraint: \"Constraints\",\r\n    constraints: \"Constraints\"\r\n  };\r\n\r\n  return typeMap[\r\n    String(stype || \"\")\r\n      .toLowerCase()\r\n      .trim()\r\n  ] || \"Others\";\r\n}\r\n    function generateTypeCounts() {\r\n      typeCountsFromServer = {};\r\n\r\n      objects.forEach(obj => {\r\n        if (!typeCountsFromServer[obj.type]) {\r\n          typeCountsFromServer[obj.type] = 0;\r\n        }\r\n        typeCountsFromServer[obj.type]++;\r\n      });\r\n    }\r\n\r\n    function getTypes() {\r\n      const orderedTypes = [\r\n        \"TStructs\",\r\n        \"iViews\",\r\n        \"Pages\",\r\n        \"Cards\",\r\n        \"Data Sources\",\r\n\r\n        \"Developer Options\",\r\n        \"AXVars\",\r\n        \"User Roles\",\r\n        \"User Groups\",\r\n\r\n        \"Tables\",\r\n        \"Views\",\r\n        \"Materialized Views\",\r\n        \"Functions\",\r\n        \"Procedures\",\r\n        \"Triggers\",\r\n        \"Index\",\r\n        \"Sequences\",\r\n        \"Constraints\",\r\n\r\n        \"Others\"\r\n      ];\r\n\r\n      return orderedTypes.filter(\r\n        type => typeCountsFromServer[type]\r\n      );\r\n    }\r\n\r\n    function setActiveType(type) {\r\n      activeType = type;\r\n      renderSummaryCards();\r\n      renderSideMenu();\r\n      renderRows();\r\n    }\r\n\r\n    function renderSummaryCards() {\r\n      document.getElementById(\"summaryCards\").innerHTML = getTypes()\r\n        .filter(type =>\r\n          [\r\n            \"TStructs\",\r\n            \"iViews\",\r\n            \"Pages\",\r\n            \"Data Sources\"\r\n          ].includes(type))\r\n        .map(type => `\r\n          <div class=\"summary-card ${activeType === type ? \"active\" : \"\"}\" onclick=\"setActiveType('${type}')\">\r\n            <div class=\"card-icon ${typeColors[type]}\">${getShortName(type)}</div>\r\n            <div>\r\n              <label>${type}</label>\r\n              <h2>${typeCountsFromServer[type]}</h2>\r\n            </div>\r\n          </div>\r\n        `).join(\"\");\r\n    }\r\n\r\n    function renderSideMenu() {\r\n      const total = Object.values(typeCountsFromServer).reduce((a, b) => a + b, 0);\r\n\r\n      document.getElementById(\"sideMenu\").innerHTML = `\r\n        <button class=\"side-link ${activeType === \"\" ? \"active\" : \"\"}\" onclick=\"setActiveType('')\">\r\n          <span>All Objects</span>\r\n          <b>${total}</b>\r\n        </button>\r\n        ${getTypes().map(type => `\r\n          <button class=\"side-link ${activeType === type ? \"active\" : \"\"}\" onclick=\"setActiveType('${type}')\">\r\n            <span>${type}</span>\r\n            <b>${typeCountsFromServer[type]}</b>\r\n          </button>\r\n        `).join(\"\")}\r\n      `;\r\n    }\r\n\r\n    function getFilteredObjects() {\r\n      const search = document.getElementById(\"searchInput\").value.toLowerCase();\r\n      const sortBy = document.getElementById(\"sortBy\").value;\r\n\r\n      let data = objects.filter(obj => {\r\n        const matchType = !activeType || obj.type === activeType;\r\n\r\n        const name = String(obj.name || \"\").toLowerCase();\r\n        const code = String(obj.code || \"\").toLowerCase();\r\n        const type = String(obj.type || \"\").toLowerCase();\r\n\r\n        const matchSearch =\r\n          name.includes(search) ||\r\n          code.includes(search) ||\r\n          type.includes(search);\r\n\r\n        return matchType && matchSearch;\r\n      });\r\n\r\n      data.sort((a, b) => String(a[sortBy]).localeCompare(String(b[sortBy])));\r\n\r\n      return data;\r\n    }\r\n\r\n    function renderRows() {\r\n      const data = getFilteredObjects();\r\n\r\n      if (!data.length) {\r\n        document.getElementById(\"objectRows\").innerHTML = `\r\n          <div style=\"padding:30px;color:#667085;text-align:center;\">\r\n            No objects found\r\n          </div>\r\n        `;\r\n        return;\r\n      }\r\n\r\n      document.getElementById(\"objectRows\").innerHTML = data.map(obj => {\r\n        const checked = selectedObjects.has(obj.id);\r\n        const pillClass = typeClass[obj.type] || \"role\";\r\n\r\n        return `\r\n          <div class=\"table-row ${checked ? \"selected\" : \"\"}\">\r\n            <label>\r\n              <input type=\"checkbox\" ${checked ? \"checked\" : \"\"} onchange=\"toggleSelect('${obj.id}', this.checked)\" />\r\n              <div>\r\n                <strong>${obj.name}</strong>\r\n                <small>${obj.code}</small>\r\n              </div>\r\n            </label>\r\n\r\n            <span class=\"pill ${pillClass}\">${obj.type}</span>\r\n\r\n            <div class=\"object-meta\">\r\n              Included in package export by object type.\r\n            </div>\r\n          </div>\r\n        `;\r\n      }).join(\"\");\r\n    }\r\n\r\n    function toggleSelect(id, checked) {\r\n      checked ? selectedObjects.add(id) : selectedObjects.delete(id);\r\n      renderRows();\r\n      updateSummary();\r\n    }\r\n\r\n    function updateSummary() {\r\n      const selected = objects.filter(obj => selectedObjects.has(obj.id));\r\n      const typeCount = new Set(selected.map(x => x.type)).size;\r\n\r\n      document.getElementById(\"selectedCount\").innerText = selected.length;\r\n      document.getElementById(\"selectedTypes\").innerText = typeCount;\r\n      document.getElementById(\"footerSelected\").innerText = `${selected.length} objects selected`;\r\n      document.getElementById(\"footerStatus\").innerText =\r\n        selected.length ? \"Ready to preview and publish\" : \"Select objects to create package\";\r\n    }\r\n\r\n    function openPreviewModal() {\r\n      const selected = objects.filter(obj => selectedObjects.has(obj.id));\r\n\r\n      if (!selected.length) {\r\n        parent.showAlertDialog(\"warn\", \"Please select at least one object.\");\r\n        return;\r\n      }\r\n\r\n      document.getElementById(\"modalPackageName\").value =\r\n        document.getElementById(\"packageName\").value;\r\n\r\n      document.getElementById(\"modalGitBranch\").value =\r\n        document.getElementById(\"gitBranch\").value;\r\n\r\n      document.getElementById(\"modalPackageDescription\").value =\r\n        document.getElementById(\"packageDescription\").value;\r\n\r\n      document.getElementById(\"modalSelectedCount\").innerText =\r\n        selected.length;\r\n\r\n      document.getElementById(\"modalTypeCount\").innerText =\r\n        new Set(selected.map(x => x.type)).size;\r\n\r\n      document.getElementById(\"modalObjectList\").innerHTML =\r\n        selected.map(obj => `\r\n      <div class=\"modal-row\">\r\n        <div>\r\n          <strong>${obj.name}</strong>\r\n          <small>${obj.code}</small>\r\n        </div>\r\n        <span class=\"pill ${typeClass[obj.type]}\">${obj.type}</span>\r\n      </div>\r\n    `).join(\"\");\r\n\r\n      document.getElementById(\"previewModal\").style.display = \"flex\";\r\n    }\r\n\r\n    function closePreviewModal() {\r\n      document.getElementById(\"previewModal\").style.display = \"none\";\r\n    }\r\n\r\n    function publishPackage(skipPopup = false) {\r\n      const selected = objects.filter(obj => selectedObjects.has(obj.id));\r\n\r\n      if (!selected.length) {\r\n        parent.showAlertDialog(\"warn\", \"Please select at least one object.\");\r\n        return;\r\n      }\r\n\r\n      if (skipPopup) {\r\n        pushToQueue({\r\n          packageName: document.getElementById(\"packageName\").value,\r\n          packageDescription: document.getElementById(\"packageDescription\").value,\r\n          gitBranch: document.getElementById(\"gitBranch\").value,\r\n          objects: selected\r\n        });\r\n        return;\r\n      }\r\n\r\n      pushToQueue({\r\n        packageName:\r\n          document.getElementById(\"modalPackageName\").value ||\r\n          document.getElementById(\"packageName\").value,\r\n\r\n        packageDescription:\r\n          document.getElementById(\"modalPackageDescription\").value ||\r\n          document.getElementById(\"packageDescription\").value,\r\n\r\n        gitBranch:\r\n          document.getElementById(\"modalGitBranch\").value ||\r\n          document.getElementById(\"gitBranch\").value,\r\n\r\n        objects: selected\r\n      });\r\n\r\n      closePreviewModal();\r\n      refreshPage();\r\n    }\r\n\r\n    function refreshPage() {\r\n      selectedObjects.clear();\r\n      activeType = \"\";\r\n\r\n      document.getElementById(\"packageName\").value = \"\";\r\n      document.getElementById(\"packageDescription\").value = \"\";\r\n      document.getElementById(\"gitBranch\").value = \"main\";\r\n      document.getElementById(\"searchInput\").value = \"\";\r\n      document.getElementById(\"selectAll\").checked = false;\r\n\r\n      init();\r\n    }\r\n\r\n    function pushToQueue(packageInfo) {\r\n      const exportObjects = {\r\n        tstruct: [],\r\n        iview: [],\r\n        custompage: [],\r\n        cards: [],\r\n        ads: [],\r\n        developeroption: [],\r\n        axvars: [],\r\n        userrole: [],\r\n        usergroup: [],\r\n        tables: [],\r\n        views: [],\r\n        materializedview: [],\r\n        functions: [],\r\n        procedures: [],\r\n        triggers: [],\r\n        index: [],\r\n        sequence: [],\r\n        constraint: []\r\n      };\r\n\r\n      packageInfo.objects.forEach(item => {\r\n        switch (item.type) {\r\n          case \"TStructs\":\r\n            exportObjects.tstruct.push(item.code);\r\n            break;\r\n\r\n          case \"iViews\":\r\n            exportObjects.iview.push(item.code);\r\n            break;\r\n\r\n          case \"Cards\":\r\n            exportObjects.cards.push(item.code);\r\n            break;\r\n\r\n          case \"Pages\":\r\n            exportObjects.custompage.push(\r\n              item.raw?.caption || item.name\r\n            );\r\n            break;\r\n\r\n          case \"Data Sources\":\r\n            exportObjects.ads.push(item.code);\r\n            break;\r\n\r\n          case \"Developer Options\":\r\n            exportObjects.developeroption.push(item.code);\r\n            break;\r\n\r\n          case \"AXVars\":\r\n            exportObjects.axvars.push(item.code);\r\n            break;\r\n\r\n          case \"User Roles\":\r\n            exportObjects.userrole.push(item.code);\r\n            break;\r\n\r\n          case \"User Groups\":\r\n            exportObjects.usergroup.push(item.code);\r\n            break;\r\n\r\n          case \"Tables\":\r\n            exportObjects.tables.push(item.code);\r\n            break;\r\n\r\n          case \"Views\":\r\n            exportObjects.views.push(item.code);\r\n            break;\r\n\r\n          case \"Materialized Views\":\r\n            exportObjects.materializedview.push(item.code);\r\n            break;\r\n\r\n          case \"Functions\":\r\n            exportObjects.functions.push(item.code);\r\n            break;\r\n\r\n          case \"Procedures\":\r\n            exportObjects.procedures.push(item.code);\r\n            break;\r\n\r\n          case \"Triggers\":\r\n            exportObjects.triggers.push(item.code);\r\n            break;\r\n\r\n          case \"Index\":\r\n            exportObjects.index.push(item.code);\r\n            break;\r\n\r\n          case \"Sequences\":\r\n            exportObjects.sequence.push(item.code);\r\n            break;\r\n\r\n          case \"Constraints\":\r\n            exportObjects.constraint.push(item.code);\r\n            break;\r\n        }\r\n      });\r\n\r\n      const timeStamp = new Date()\r\n        .toISOString()\r\n        .replace(/[-:T]/g, '')\r\n        .slice(0, 14);\r\n\r\n      const queueData = {\r\n        requestId: `PKG-${timeStamp}-${Math.floor(Math.random() * 1000)}`,\r\n        appName: parent.mainProject || \"default\",\r\n        packageName: packageInfo.packageName,\r\n        packageVersion: \"1.0.0\",\r\n        requestedBy: parent.mainUserName || \"admin\",\r\n        objects: exportObjects,\r\n        publish: {\r\n          repository: \"AxpertPackages\",\r\n          branch: packageInfo.gitBranch || \"main\",\r\n          packageDescription: packageInfo.packageDescription,\r\n          packageAuthor: parent.mainUserName || \"admin\",\r\n          tags: [],\r\n          category: \"\",\r\n          icon: \"shopping_cart\",\r\n          colorClass: \"orange\"\r\n        }\r\n      };\r\n\r\n      const finalPayload = {\r\n        queuename: \"axiexportpackagesqueue\",\r\n        apiname: \"axipackages\",\r\n        queuedata: JSON.stringify(queueData),\r\n        timespandelay: \"0\"\r\n      };\r\n\r\n      //const apiUrl = `${parent.armUrl}/ARM_APIs/api/v1/ARMPushToQueue`;\r\n      const apiUrl = `https://agileqa.agilecloud.biz/ARM_Site/ARM_APIs/api/v1/ARMPushToQueue`;\r\n      fetch(apiUrl, {\r\n        method: \"POST\",\r\n        headers: {\r\n          \"Content-Type\": \"application/json\"\r\n        },\r\n        body: JSON.stringify(finalPayload)\r\n      })\r\n        .then(response => {\r\n          if (!response.ok) {\r\n            throw new Error(`HTTP Error: ${response.status}`);\r\n          }\r\n          return response.json();\r\n        })\r\n        .then(data => {\r\n          console.log(\"Queue Push Success:\", data);\r\n          parent.showAlertDialog(\"success\",\r\n            `${packageInfo.objects.length} objects successfully pushed to queue`\r\n          );\r\n        })\r\n        .catch(error => {\r\n          console.error(\"Queue Push Error:\", error);\r\n          parent.showAlertDialog(\"error\",\r\n            \"Failed to push package to queue\"\r\n          );\r\n        });\r\n    }\r\n\r\n    function getShortName(type) {\r\n      if (type === \"TStructs\") return \"TS\";\r\n      if (type === \"iViews\") return \"IV\";\r\n      if (type === \"Pages\") return \"PG\";\r\n      if (type === \"Cards\") return \"CD\";\r\n      if (type === \"Data Sources\") return \"DS\";\r\n\r\n      if (type === \"Developer Options\") return \"DO\";\r\n      if (type === \"AXVars\") return \"AV\";\r\n      if (type === \"User Roles\") return \"UR\";\r\n      if (type === \"User Groups\") return \"UG\";\r\n\r\n      if (type === \"Tables\") return \"TB\";\r\n      if (type === \"Views\") return \"VW\";\r\n      if (type === \"Materialized Views\") return \"MV\";\r\n      if (type === \"Functions\") return \"FN\";\r\n      if (type === \"Procedures\") return \"SP\";\r\n      if (type === \"Triggers\") return \"TR\";\r\n      if (type === \"Index\") return \"IX\";\r\n      if (type === \"Sequences\") return \"SQ\";\r\n      if (type === \"Constraints\") return \"CS\";\r\n\r\n      return \"OB\";\r\n    }\r\n\r\n    init();\r\n  </script>\r\n\r\n\r\n\r\n</body></html>\r\n"
              }
            },
            "dc3": {}
          }
        }
      ]
    }
  }
}