              "row1": {
                "sqlname": "ADS_canditate",
                "sqlsrc": "For users",
                "sqlsrccnd": "3",
                "sqltext": "SELECT c.empid,c.empname,c.doj,c.yoe,c.dep,c.email,d2.paycomp,d2.paycompdesp,d2.oldvalue,d2.newvalue,d3.summary,d3.tot \r\nFROM candt1 c LEFT JOIN candt2 d2 ON c.candt1id = d2.candt1id LEFT JOIN candt3 d3 ON c.candt1id = d3.candt1id",
